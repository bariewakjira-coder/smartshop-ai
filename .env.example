# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/smartshop_ai_db
POSTGRES_USER=smartshop_user
POSTGRES_PASSWORD=secure_password_here
POSTGRES_DB=smartshop_ai_db

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=redis_password_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRE_IN=30d

# OpenAI (for Chatbot)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7

# ML Service
ML_SERVICE_URL=http://localhost:5000
ML_SERVICE_API_KEY=your_ml_service_api_key

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@smartshopai.com

# Stripe (Payment)
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Cloud Storage (Optional)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your_bucket_name
AWS_REGION=us-east-1

# Logging & Monitoring
SENTRY_DSN=your_sentry_dsn_url
LOG_LEVEL=info

# Session
SESSION_SECRET=your_session_secret_key

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=15000
RATE_LIMIT_MAX_REQUESTS=100

# Admin Credentials
ADMIN_EMAIL=admin@smartshopai.com
ADMIN_PASSWORD=initial_admin_password_change_this
